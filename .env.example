# This is a quick-reference copy of all environment variables used in this
# project. The values that actually get read live in:
#   server/.env   (copy from server/.env.example)
#   client/.env   (copy from client/.env.example)

# ---------- server/.env ----------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/food-delivery
JWT_SECRET=replace_this_with_a_long_random_secret
PORT=5000
ADMIN_WHATSAPP_NUMBER=919876543210
RESTAURANT_NAME=Tasty Bites
CLIENT_URL=http://localhost:5173
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# ---------- client/.env ----------
VITE_API_URL=http://localhost:5000/api
