# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/food-delivery

# JWT secret used to sign admin login tokens
JWT_SECRET=replace_this_with_a_long_random_secret

# Port for the backend server
PORT=5000

# Restaurant admin WhatsApp number (with country code, digits only)
# Example: 919876543210
ADMIN_WHATSAPP_NUMBER=919876543210

# Restaurant name shown in messages
RESTAURANT_NAME=Tasty Bites

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Optional: WhatsApp Cloud API (official Meta Business Platform)
# Leave these blank to use the safe fallback: a pre-filled wa.me link
# that the admin/customer opens manually to send the WhatsApp message.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
